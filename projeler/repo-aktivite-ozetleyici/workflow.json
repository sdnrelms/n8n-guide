        "jsCode": "const commits = $input.all();\n\nconst commitListesi = commits.map(item => {\n  const msg = item.json.commit.message;\n  const author = item.json.commit.author.name;\n  const date = item.json.commit.author.date;\n  return `- [${date}] ${author}: ${msg}`;\n}).join('\\n');\n\nconst prompt = `Aşağıda bir GitHub reposundaki son commit'lerin listesi var. Bunları kısa, akıcı bir Türkçe paragraf halinde özetle. Kimin ne yaptığını ve genel gelişmeyi vurgula:\\n\\n${commitListesi}`;\n\nreturn [{ json: { prompt, repoAdi: \"netprobe_reliable_udp_protocol\" } }];"
      },
